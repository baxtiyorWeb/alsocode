# =======================================================================
# NEURAL LLM STUDIO - GITIGNORE SPECIFICATION
# =======================================================================

# 1. Bog'liqliklar va paketlar (Dependencies)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 2. Xavfsizlik va Maxfiy Ma'lumotlar (Secrets & Environment Variables)
.env
.env.local
.env.*.local
*.pem
*.key

# 3. Katta Neyron Tarmoq Modellari va Og'irliklar (>50MB va >100MB GitHub limitlari)
data/checkpoints/*
!data/checkpoints/.gitkeep
data/archive_legacy_mlp/
data/backups/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*transformer_best.json
*transformer_latest.json

# 4. Arxivlar va Staging Fayllari
llm_staging/
*.zip
*.tar.gz
*.tgz
llm_colab_package.zip

# 5. Python Kesh va Virtual Muhitlar
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# 6. Foydalanuvchi Sessiyalari va Vaqtinchalik Loglar
data/sessions.json
logs/
*.log
.system_generated/

# 7. Operatsion Tizim va Muharrir Fayllari
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
